FROM node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=2.1.247

LABEL org.opencontainers.image.title="Agent Broadcast Claude participant" \
      org.opencontainers.image.source="https://github.com/andrzejdus/agent-broadcast-mcp" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git python3 ripgrep \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && usermod --login agent --home /home/agent --move-home node \
    && groupmod --new-name agent node

WORKDIR /opt/agent-broadcast
COPY --chown=agent:agent runner ./runner
COPY --chown=agent:agent plugins/agent-broadcast/skills/agent-broadcast-start /home/agent/.agents/skills/agent-broadcast-start
COPY containers/container-entrypoint.sh /usr/local/bin/agent-broadcast-entrypoint

RUN mkdir -p /workspace /home/agent/.claude/skills \
    && printf '%s\n' 'managed by agent-broadcast-mcp' > /home/agent/.agents/skills/agent-broadcast-start/.agent-broadcast-managed \
    && ln -s /home/agent/.agents/skills/agent-broadcast-start /home/agent/.claude/skills/agent-broadcast-start \
    && chown -R agent:agent /workspace /home/agent/.claude /home/agent/.agents

ENV AGENT_HARNESS=claude \
    AGENT_WORKSPACE=/workspace \
    CLAUDE_CONFIG_DIR=/home/agent/.claude \
    DISABLE_AUTOUPDATER=1

USER agent
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/agent-broadcast-entrypoint"]
